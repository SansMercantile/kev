# Environment variables
.env
.env.local
.env.*.local
.env.development
.env.test
.azure-deployment.env
# .env.production is committed: it carries only PUBLIC PKCE config (Auth0
# domain + SPA client ID, safe for a browser bundle) so the Vercel build inlines
# it. Secrets never go here.
!.env.production

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (Vercel rebuilds; never commit)
dist/

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
