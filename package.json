{
  "name": "kev",
  "version": "1.0.0",
  "description": "Educational system with Central Library and Curriculum Framework for 185+ subjects",
  "type": "module",
  "scripts": {
    "dev": "vite --mode platform --port 3002",
    "dev:site": "vite --mode site --port 3003",
    "build": "vite build --mode site",
    "build:app": "vite build --mode platform",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:campus": "node scripts/verifyCampusScene.mjs",
    "preview": "vite preview --port 3003",
    "preview:app": "vite preview --port 3004",
    "api:client": "node tools/kev-api-client/fetch-openapi.cjs && node tools/kev-api-client/generate.cjs",
    "api:drift": "node tools/spec-drift/check.cjs",
    "attribution:check": "node tools/attribution-check/check.cjs",
    "i18n:check": "node scripts/i18n-check.cjs",
    "i18n:glossary": "node tools/i18n-glossary/check.cjs",
    "gates": "npm run typecheck && npm run i18n:check && npm run i18n:glossary && npm run atlas:check && npm run attribution:check && npm run api:drift && npm run verify:campus",
    "atlas:check": "node scripts/check-atlas.cjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.23.0",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.413.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
